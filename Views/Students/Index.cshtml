@model IEnumerable<ITI_FinalProject.Models.Student>

@{
    ViewData["Title"] = "Index";
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var search = ViewData["Search"] as string;
    var courseFilter = ViewData["CourseFilter"] as int?;
}

<style>
    .filter-bar {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 22px;
    }

        .filter-bar input[type=text], .filter-bar select {
            min-width: 240px;
            padding: 14px 18px;
            border: 1px solid #cfe6e3;
            border-radius: 14px;
            background: #fff;
            font-size: 16px;
            color: #0f3d3a;
            outline: none;
        }

            .filter-bar input[type=text]:focus, .filter-bar select:focus {
                border-color: #12a594;
                box-shadow: 0 0 0 3px rgba(18, 165, 148, .15);
            }

    .btn-filter {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        border-radius: 14px;
        padding: 14px 26px;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: linear-gradient(135deg, #12a594, #0d7f78);
        box-shadow: 0 6px 16px rgba(13, 127, 120, .28);
    }

        .btn-filter:hover {
            filter: brightness(.95);
        }

    .btn-clear {
        color: #799a9f;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-clear:hover {
            color: #0d7f78;
        }

    .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        vertical-align: middle;
        margin-right: 10px;
    }

    .avatar-ph {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e6f6f4;
        color: #0d7f78;
        font-weight: 700;
        vertical-align: middle;
        margin-right: 10px;
    }

    .pager {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
        margin-top: 22px;
        flex-wrap: wrap;
    }

        .pager a, .pager span {
            min-width: 40px;
            padding: 9px 14px;
            border-radius: 12px;
            text-align: center;
            font-weight: 700;
            font-size: 14px;
            text-decoration: none;
        }

        .pager a {
            background: #e6f6f4;
            color: #0d7f78;
        }

            .pager a:hover {
                background: #12a594;
                color: #fff;
            }

        .pager .current {
            background: linear-gradient(135deg, #12a594, #0d7f78);
            color: #fff;
        }

        .pager .disabled {
            background: #f1f5f5;
            color: #b6c6c8;
        }
</style>

<h1>Students</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-action="Index" method="get" class="filter-bar">
    <input type="text" name="search" value="@ViewData["Search"]" placeholder="Search by name or email" />
    <select name="courseId" asp-items="ViewBag.CourseId">
        <option value="">All courses</option>
    </select>
    <button type="submit" class="btn-filter">&#9660; Filter</button>
    <a asp-action="Index" class="btn-clear">Clear</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FullName)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
            <th>@Html.DisplayNameFor(model => model.DateOfBirth)</th>
            <th>@Html.DisplayNameFor(model => model.EnrollmentDate)</th>
            <th>@Html.DisplayNameFor(model => model.Department)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ProfileImagePath))
                    {
                        <img src="@item.ProfileImagePath" alt="" class="avatar" />
                    }
                    else
                    {
                        <span class="avatar-ph">@(string.IsNullOrEmpty(item.FullName) ? "?" : item.FullName.Substring(0, 1).ToUpper())</span>
                    }
                    @item.FullName
                </td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                <td>@Html.DisplayFor(modelItem => item.EnrollmentDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Department.Name)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="ManageCourses" asp-route-id="@item.Id">Manage Courses</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPages > 1)
{
    <div class="pager">
        @if (page > 1)
        {
            <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@search" asp-route-courseId="@courseFilter">&laquo; Prev</a>
        }
        else
        {
            <span class="disabled">&laquo; Prev</span>
        }

        @for (var i = 1; i <= totalPages; i++)
        {
            if (i == page)
            {
                <span class="current">@i</span>
            }
            else
            {
                <a asp-action="Index" asp-route-page="@i" asp-route-search="@search" asp-route-courseId="@courseFilter">@i</a>
            }
        }

        @if (page < totalPages)
        {
            <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@search" asp-route-courseId="@courseFilter">Next &raquo;</a>
        }
        else
        {
            <span class="disabled">Next &raquo;</span>
        }
    </div>
}