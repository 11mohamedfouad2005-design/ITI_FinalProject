@model ITI_FinalProject.Models.Student

@{
    ViewData["Title"] = "Manage Courses";
    var enrollments = (List<ITI_FinalProject.Models.Enrollment>)ViewBag.Enrollments;
    var hasAvailable = (bool)ViewBag.HasAvailableCourses;
}

<style>
    .mc-card {
        background: #fff;
        border: 1px solid #cfe6e3;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 24px;
    }

        .mc-card h4 {
            color: #0f3d3a;
            margin-bottom: 16px;
        }

    .mc-add-form {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        align-items: center;
    }

        .mc-add-form select {
            min-width: 240px;
            padding: 14px 18px;
            border: 1px solid #cfe6e3;
            border-radius: 14px;
            background: #fff;
            font-size: 16px;
            color: #0f3d3a;
            outline: none;
        }

            .mc-add-form select:focus {
                border-color: #12a594;
                box-shadow: 0 0 0 3px rgba(18, 165, 148, .15);
            }

    .btn-add {
        border: none;
        border-radius: 14px;
        padding: 14px 26px;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: linear-gradient(135deg, #12a594, #0d7f78);
        box-shadow: 0 6px 16px rgba(13, 127, 120, .28);
    }

        .btn-add:hover {
            filter: brightness(.95);
        }

    .btn-remove {
        border: none;
        border-radius: 10px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: #e5484d;
    }

        .btn-remove:hover {
            filter: brightness(.92);
        }

    .mc-alert {
        padding: 12px 18px;
        border-radius: 12px;
        margin-bottom: 18px;
        font-weight: 600;
    }

    .mc-success {
        background: #e6f6f4;
        color: #0d7f78;
    }

    .mc-error {
        background: #fdecec;
        color: #b42318;
    }

    .mc-muted {
        color: #799a9f;
    }

    .mc-table {
        width: 100%;
        table-layout: fixed;
    }

        .mc-table th:nth-child(1) {
            width: 18%;
        }

        .mc-table th:nth-child(2) {
            width: 42%;
        }

        .mc-table th:nth-child(3) {
            width: 22%;
        }

        .mc-table th:nth-child(4) {
            width: 18%;
            text-align: right;
        }

        .mc-table td:last-child {
            text-align: right;
        }

        .mc-table td form {
            margin: 0;
            display: inline-block;
        }
</style>

<h1>Manage Courses</h1>
<p class="mc-muted">@Model.FullName (@Model.Email)</p>

@if (TempData["Success"] != null)
{
    <div class="mc-alert mc-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mc-alert mc-error">@TempData["Error"]</div>
}

<div class="mc-card">
    <h4>Enrolled Courses</h4>

    @if (enrollments.Any())
    {
        <table class="table mc-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Course Title</th>
                    <th>Enrollment Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in enrollments)
                {
                    <tr>
                        <td>@e.Course?.Code</td>
                        <td>@e.Course?.Title</td>
                        <td>@e.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <form asp-action="RemoveCourse" method="post"
                                  onsubmit="return confirm('Remove this course from the student?');">
                                <input type="hidden" name="studentId" value="@Model.Id" />
                                <input type="hidden" name="courseId" value="@e.CourseId" />
                                <button type="submit" class="btn-remove">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="mc-muted">This student is not enrolled in any course yet.</p>
    }
</div>

<div class="mc-card">
    <h4>Add Course</h4>

    @if (hasAvailable)
    {
        <form asp-action="AddCourse" method="post" class="mc-add-form">
            <input type="hidden" name="studentId" value="@Model.Id" />
            <select name="courseId" asp-items="ViewBag.AvailableCourses"></select>
            <button type="submit" class="btn-add">+ Add</button>
        </form>
    }
    else
    {
        <p class="mc-muted">The student is already enrolled in all available courses.</p>
    }
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>