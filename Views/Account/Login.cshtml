@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Course Registration</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            color: #0f3d3e;
            background:
                linear-gradient(rgba(214, 243, 240, .50), rgba(214, 243, 240, .50)), url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1920&auto=format&fit=crop') center / cover no-repeat fixed, linear-gradient(135deg, #bfe9e4, #e6f6f4);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .card {
            width: 100%;
            max-width: 504px;
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-radius: 44px;
            padding: 46px 46px 38px;
            box-shadow: 0 25px 60px rgba(15, 61, 62, .18);
            text-align: center;
        }

        .logo-box {
            width: 72px; height: 72px;
            margin: 0 auto 18px;
            border: 2px solid #14b8a6;
            border-radius: 22px;
            background: #fff;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 8px 22px rgba(20, 184, 166, .25);
        }

        h1 { font-size: 32px; font-weight: 800; color: #0f3d3e; margin-bottom: 8px; }
        .subtitle { color: #4b7f86; font-size: 15px; margin-bottom: 38px; }

        .field { text-align: left; margin-bottom: 22px; }
        .field label {
            display: block;
            font-size: 12px; font-weight: 700;
            letter-spacing: .6px; text-transform: uppercase;
            color: #0f3d3e;
            margin-bottom: 8px;
        }
        .input-wrap { position: relative; }
        .input-wrap svg {
            position: absolute; left: 18px; top: 50%;
            transform: translateY(-50%);
        }
        .input-wrap input {
            width: 100%;
            height: 54px;
            padding: 0 18px 0 52px;
            border: 1.5px solid #cfe2ee;
            border-radius: 18px;
            background: #edf3fd;
            font-size: 15px;
            color: #0f3d3e;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }
        .input-wrap input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 4px rgba(20, 184, 166, .15);
            background: #fff;
        }
        .field-error { display: block; color: #dc2626; font-size: 13px; margin-top: 6px; }
        .summary-error {
            background: #fee2e2; color: #b91c1c;
            border-radius: 14px;
            padding: 10px 14px;
            font-size: 14px;
            margin-bottom: 18px;
            text-align: left;
        }
        .summary-error ul { list-style: none; }

        .remember {
            display: flex; align-items: center; gap: 8px;
            font-size: 14px; color: #4b7f86;
            margin: -6px 0 20px;
            text-align: left;
        }
        .remember input { width: 16px; height: 16px; accent-color: #0d9488; }

        .btn-login {
            width: 100%;
            height: 54px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(135deg, #12a594, #0d7f78);
            color: #fff;
            font-size: 16px; font-weight: 700;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            box-shadow: 0 10px 24px rgba(13, 127, 120, .35);
            transition: transform .15s, box-shadow .15s;
        }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(13, 127, 120, .4); }

        .register-line { margin-top: 16px; font-size: 14px; color: #4b7f86; }
        .register-line a { color: #0d9488; font-weight: 700; text-decoration: none; }
        .register-line a:hover { text-decoration: underline; }

        .portal-box {
            margin-top: 24px;
            padding: 16px 14px;
            border: 1px solid #cdeae6;
            border-radius: 20px;
            background: rgba(236, 250, 248, .8);
        }
        .portal-title {
            display: flex; align-items: center; justify-content: center; gap: 6px;
            font-size: 13px; font-weight: 700; color: #0d9488;
            margin-bottom: 12px;
        }
        .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
        .chip {
            background: #fff;
            border-radius: 999px;
            padding: 6px 14px;
            font-size: 13px; color: #0f3d3e;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .06);
        }

        .back { display: inline-block; margin-top: 26px; font-size: 13px; font-weight: 700; color: #0d9488; text-decoration: none; }
        .back:hover { text-decoration: underline; }

        @@media (max-width: 560px) {
            .card { padding: 34px 24px 28px; border-radius: 32px; }
            .brand { left: 16px; top: 14px; }
            body { align-items: flex-start; padding-top: 90px; }
        }
    </style>
</head>
<body>

    

    <div class="card">
        <div class="logo-box">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" />
                <path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" />
            </svg>
        </div>

        <h1>Welcome Back</h1>
        <p class="subtitle">Enter your account credentials to continue learning</p>

        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="summary-error"></div>

            <div class="field">
                <label asp-for="Email">Email address</label>
                <div class="input-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>
                    <input asp-for="Email" placeholder="name@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Password</label>
                <div class="input-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="11" width="16" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                    <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <label class="remember">
                <input asp-for="RememberMe" />
                Remember me
            </label>

            <button type="submit" class="btn-login">
                Sign in to Dashboard
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </button>
        </form>

        <p class="register-line">
            New student? <a asp-action="Register">Create an account</a>
        </p>

        <div class="portal-box">
            <div class="portal-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                Single unified portal for:
            </div>
            <div class="chips">
                <span class="chip">🎓 Student</span>
                <span class="chip">🛡️ Admin</span>
            </div>
        </div>

        <a asp-controller="Home" asp-action="Index" class="back">← Back to home page</a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>