@model RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduFlow</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            color: #0f3d3e;
            background: linear-gradient(rgba(214, 243, 240, .50), rgba(214, 243, 240, .50)), url('https://media.istockphoto.com/id/2189800037/photo/university-students-studying-and-discussing-standing-on-the-steps-of-the-campus.jpg?s=2048x2048&w=is&k=20&c=h7BRbi4gCP-FPYrTyPKdtSHUUDjRIb4SBR6AeH7tSGs=') center / cover no-repeat fixed, linear-gradient(135deg, #bfe9e4, #e6f6f4);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }


        .card {
            width: 100%;
            max-width: 580px;
            margin: 40px 0;
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-radius: 44px;
            padding: 42px 46px 36px;
            box-shadow: 0 25px 60px rgba(15, 61, 62, .18);
            text-align: center;
        }

        .logo-box {
            width: 72px;
            height: 72px;
            margin: 0 auto 16px;
            border: 2px solid #14b8a6;
            border-radius: 22px;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 22px rgba(20, 184, 166, .25);
        }

        h1 {
            font-size: 30px;
            font-weight: 800;
            color: #0f3d3e;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #4b7f86;
            font-size: 15px;
            margin-bottom: 30px;
        }

        .row2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .field {
            text-align: left;
            margin-bottom: 18px;
        }

            .field label {
                display: block;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: .6px;
                text-transform: uppercase;
                color: #0f3d3e;
                margin-bottom: 8px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap svg {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                pointer-events: none;
            }

            .input-wrap input,
            .input-wrap select {
                width: 100%;
                height: 52px;
                padding: 0 14px 0 48px;
                border: 1.5px solid #cfe2ee;
                border-radius: 18px;
                background: #edf3fd;
                font-size: 15px;
                color: #0f3d3e;
                outline: none;
                transition: border-color .2s, box-shadow .2s;
            }

                .input-wrap input:focus,
                .input-wrap select:focus {
                    border-color: #14b8a6;
                    box-shadow: 0 0 0 4px rgba(20, 184, 166, .15);
                    background: #fff;
                }

        .field-error {
            display: block;
            color: #dc2626;
            font-size: 13px;
            margin-top: 6px;
        }

        .summary-error {
            background: #fee2e2;
            color: #b91c1c;
            border-radius: 14px;
            padding: 10px 14px;
            font-size: 14px;
            margin-bottom: 18px;
            text-align: left;
        }

            .summary-error ul {
                list-style: none;
            }

        .btn-register {
            width: 100%;
            height: 54px;
            margin-top: 6px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(135deg, #12a594, #0d7f78);
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 10px 24px rgba(13, 127, 120, .35);
            transition: transform .15s, box-shadow .15s;
        }

            .btn-register:hover {
                transform: translateY(-2px);
                box-shadow: 0 14px 28px rgba(13, 127, 120, .4);
            }

        .login-line {
            margin-top: 16px;
            font-size: 14px;
            color: #4b7f86;
        }

            .login-line a {
                color: #0d9488;
                font-weight: 700;
                text-decoration: none;
            }

                .login-line a:hover {
                    text-decoration: underline;
                }

        .back {
            display: inline-block;
            margin-top: 22px;
            font-size: 13px;
            font-weight: 700;
            color: #0d9488;
            text-decoration: none;
        }

            .back:hover {
                text-decoration: underline;
            }

        @@media (max-width: 600px) {
            .card {
                padding: 32px 22px 26px;
                border-radius: 32px;
            }

            .row2 {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .brand {
                position: static;
                margin-bottom: 16px;
            }

            body {
                flex-direction: column;
                justify-content: flex-start;
                padding-top: 20px;
            }

            .card {
                margin-top: 0;
            }
        }
    </style>
</head>
<body>

    

    <div class="card">
        <div class="logo-box">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8" r="4" />
                <path d="M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1" />
                <path d="M19 8v6M16 11h6" />
            </svg>
        </div>

        <h1>Create Your Account</h1>
        <p class="subtitle">Join the portal and start registering for your courses</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="summary-error"></div>

            <div class="field">
                <label asp-for="FullName">Full name</label>
                <div class="input-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
                    </svg>
                    <input asp-for="FullName" placeholder="Your full name" autocomplete="name" />
                </div>
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Email">Email address</label>
                <div class="input-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>
                    <input asp-for="Email" placeholder="name@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="row2">
                <div class="field">
                    <label asp-for="PhoneNumber">Phone number</label>
                    <div class="input-wrap">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
                        </svg>
                        <input asp-for="PhoneNumber" placeholder="01xxxxxxxxx" autocomplete="tel" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="DateOfBirth">Date of birth</label>
                    <div class="input-wrap">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path d="M16 3v4M8 3v4M3 11h18" />
                        </svg>
                        <input asp-for="DateOfBirth" />
                    </div>
                    <span asp-validation-for="DateOfBirth" class="field-error"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="DepartmentId">Department</label>
                <div class="input-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18" />
                        <path d="M5 21V7l7-4 7 4v14" />
                        <path d="M9 21v-6h6v6" />
                    </svg>
                    <select asp-for="DepartmentId" asp-items="ViewBag.Departments">
                        <option value="0">-- Select department --</option>
                    </select>
                </div>
                <span asp-validation-for="DepartmentId" class="field-error"></span>
            </div>

            <div class="row2">
                <div class="field">
                    <label asp-for="Password">Password</label>
                    <div class="input-wrap">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="11" width="16" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                        <input asp-for="Password" placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <div class="input-wrap">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="11" width="16" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                        <input asp-for="ConfirmPassword" placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn-register">
                Create Account
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </button>
        </form>

        <p class="login-line">
            Already have an account? <a asp-action="Login">Sign in</a>
        </p>

        <a asp-controller="Home" asp-action="Index" class="back">← Back to home page</a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>