@model List<CourseCatalogItem>
@{
    ViewData["Title"] = "My Courses";
    var enrolledCount = Model.Count(m => m.IsEnrolled);
    var enrolledHours = Model.Where(m => m.IsEnrolled).Sum(m => m.CreditHours);
    var maxHours = (int)ViewBag.MaxHours;
}

<style>
    .seat {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12.5px;
        font-weight: 700;
    }

    .seat-ok {
        background: #dcfce7;
        color: #166534;
    }

    .seat-low {
        background: #ffedd5;
        color: #9a3412;
    }

    .seat-full {
        background: #fee2e2;
        color: #b91c1c;
    }

    .seat-sub {
        font-size: 12px;
        color: #799a9f;
        margin-top: 4px;
    }

    .enrolled-tag {
        display: inline-block;
        margin-right: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #0d7f78;
    }

    .table tbody td.enroll-cell {
        font-size: 14px !important;
    }

    .btn-enroll, .btn-drop {
        border: none;
        border-radius: 10px;
        padding: 8px 20px;
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-enroll {
        background: linear-gradient(135deg, #12a594, #0d7f78);
        color: #fff;
        box-shadow: 0 6px 16px rgba(13, 127, 120, .28);
    }

        .btn-enroll:disabled {
            background: #cbd5d3;
            box-shadow: none;
            cursor: not-allowed;
        }

    .btn-drop {
        background: #fee2e2;
        color: #b91c1c;
    }

        .btn-drop:hover {
            background: #dc2626;
            color: #fff;
        }

    .summary {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

        .summary div {
            background: #e6f6f4;
            color: #0d7f78;
            border-radius: 14px;
            padding: 10px 18px;
            font-weight: 700;
            font-size: 14px;
        }
</style>

<h1>My Courses</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="summary">
    <div>Enrolled courses: @enrolledCount</div>
    <div>Credit hours: @enrolledHours / @maxHours</div>
    <div>Remaining: @(maxHours - enrolledHours)</div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Title</th>
            <th>Instructor</th>
            <th>Department</th>
            <th>Credit hours</th>
            <th>Availability</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            var available = Math.Max(0, c.MaximumCapacity - c.Enrolled);
            var seatClass = available == 0 ? "seat-full" : (available <= 5 ? "seat-low" : "seat-ok");
            var overLimit = enrolledHours + c.CreditHours > maxHours;
            <tr>
                <td>@c.Code</td>
                <td>@c.Title</td>
                <td>@c.Instructor</td>
                <td>@c.DepartmentName</td>
                <td>@c.CreditHours</td>
                <td>
                    <span class="seat @seatClass">@(available == 0 ? "Full" : $"{available} seats left")</span>
                    <div class="seat-sub">@c.Enrolled / @c.MaximumCapacity enrolled</div>
                </td>
                <td class="enroll-cell">
                    @if (c.IsEnrolled)
                    {
                        <span class="enrolled-tag">✓ Enrolled</span>
                        <form asp-action="Drop" method="post" style="display:inline" onsubmit="return confirm('Drop this course?');">
                            <input type="hidden" name="courseId" value="@c.Id" />
                            <button type="submit" class="btn-drop">Drop</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Enroll" method="post" style="display:inline">
                            <input type="hidden" name="courseId" value="@c.Id" />
                            <button type="submit" class="btn-enroll" disabled="@(available == 0 || overLimit)">Enroll</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>