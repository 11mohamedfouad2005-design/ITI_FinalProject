@model List<ITI_FinalProject.Models.Enrollment>
@{
    ViewData["Title"] = "My Courses";
    var totalHours = Model.Sum(e => e.Course!.CreditHours);
}

<h1>My Courses</h1>

<div class="summary" style="display:flex;gap:14px;margin-bottom:18px;">
    <div style="background:#e6f6f4;color:#0d7f78;border-radius:14px;padding:10px 18px;font-weight:700;">
        Courses: @Model.Count
    </div>
    <div style="background:#e6f6f4;color:#0d7f78;border-radius:14px;padding:10px 18px;font-weight:700;">
        Credit hours: @totalHours
    </div>
</div>

@if (!Model.Any())
{
    <p>You are not enrolled in any course yet. <a asp-controller="Catalog" asp-action="Index">Browse the catalog</a></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Title</th>
                <th>Instructor</th>
                <th>Department</th>
                <th>Credit hours</th>
                <th>Enrolled on</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Course!.Code</td>
                    <td>@e.Course.Title</td>
                    <td>@e.Course.Instructor</td>
                    <td>@e.Course.Department?.Name</td>
                    <td>@e.Course.CreditHours</td>
                    <td>@e.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}